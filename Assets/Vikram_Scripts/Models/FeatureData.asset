%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 146fc4fce1d443040a4de85daf81d27f, type: 3}
  m_Name: FeatureData
  m_EditorClassIdentifier: 
  BlindSpotData:
    featureType: 0
    featureName: "BSD \u2014Blind Spot Detection"
    featureDescription: 
    EnglishCorrectAction: "BSD helps you sense what you can\u2019t see. Staying focussed
      in your lane and taking the right action keeps you confident and safe."
    ItalianCorrectAction: "Il sistema BSD ti aiuta a percepire ci\xF2 che non puoi
      vedere. Rimanere concentrato nella tua corsia e reagire nel modo giusto ti
      mantiene sicuro e fiducioso."
    EnglishWrongAction: "BSD highlights hidden motion in your blind zone. Hold lane
      until clear \u2014 avoid drifting or stopping suddenly."
    ItalianWrongAction: "Il sistema BSD evidenzia i movimenti nascosti nella tua
      zona cieca. Mantieni la corsia finch\xE9 non \xE8 libera \u2014 evita di deviare
      o fermarti bruscamente"
    safetyMessage: "Vehicle beside you\u2014hold lane."
    featureIcon: {fileID: 21300000, guid: a28bd4f2adffb994e9319fab816741a0, type: 3}
  FrontCollisionData:
    featureType: 1
    featureName: "FCW \u2014Forward Collision Warning"
    featureDescription: 
    EnglishCorrectAction: FCW gives you a critical and timely warning to react promptly
    ItalianCorrectAction: Il sistema FCW ti fornisce un avviso tempestivo e fondamentale
      per reagire prontamente
    EnglishWrongAction: When the FCW alerts are received, early and calm actions
      prevent sudden impact
    ItalianWrongAction: Quando vengono ricevuti gli avvisi FCW, azioni anticipate
      e calme evitano impatti improvvisi
    safetyMessage: "Brake\u2014smooth and early."
    featureIcon: {fileID: 21300000, guid: 5923a1c4789c34e4cbc9b70e9c1c80cf, type: 3}
  RearCollisionData:
    featureType: 2
    featureName: "RCW \u2014Rear Collision Warning"
    featureDescription: 
    EnglishCorrectAction: "RCW keeps your awareness sharp for what\u2019s closing
      in. Holding your line lets others pass safely"
    ItalianCorrectAction: "Il sistema RCW mantiene alta la tua attenzione su ci\xF2
      che si avvicina. Restare nella tua traiettoria consente agli altri di superarti
      in sicurezza"
    EnglishWrongAction: When RCW alerts are received, sudden moves should be avoided.
      Steady movement builds trust on the road
    ItalianWrongAction: "Quando vengono ricevuti gli avvisi RCW, \xE8 meglio evitare
      movimenti improvvisi. Una guida costante ispira fiducia e sicurezza sulla strada"
    safetyMessage: "Rear traffic closing\u2014steady line."
    featureIcon: {fileID: 21300000, guid: f4a71929c7315454fb0337374b6c3862, type: 3}
  CloseVehicleData:
    featureType: 3
    featureName: "CVW \u2014Close Vehicle Warning"
    featureDescription: 
    EnglishCorrectAction: 
    ItalianCorrectAction: 
    EnglishWrongAction: 
    ItalianWrongAction: 
    safetyMessage: "Space is safety\u2014stay centred."
    featureIcon: {fileID: 21300000, guid: a5c4bb4f6253c6747aa7c66db0c3f48b, type: 3}
